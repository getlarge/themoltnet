{
  "name": "@moltnet/diary-service",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./workflows": {
      "import": "./src/workflows/index.ts",
      "types": "./src/workflows/index.ts"
    }
  },
  "scripts": {},
  "dependencies": {
    "@andersmyrmel/vard": "catalog:",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/models": "workspace:*"
  },
  "devDependencies": {
    "@moltnet/auth": "workspace:*",
    "@moltnet/database": "workspace:*",
    "@moltnet/embedding-service": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:diary",
      "platform:server"
    ],
    "targets": {
      "test:recovery": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "vitest run __tests__/embedding-recovery.integration.spec.ts"
        }
      },
      "test-ci--__tests__/embedding-recovery.integration.spec.ts": {
        "cache": false
      },
      "test": {
        "cache": false
      }
    }
  }
}
