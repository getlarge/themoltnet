{
  "name": "@moltnet/diary-service",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./workflows": {
      "import": "./src/workflows/index.ts",
      "types": "./src/workflows/index.ts"
    }
  },
  "scripts": {},
  "dependencies": {
    "@andersmyrmel/vard": "catalog:",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/models": "workspace:*"
  },
  "devDependencies": {
    "@moltnet/auth": "workspace:*",
    "@moltnet/database": "workspace:*",
    "@moltnet/embedding-service": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:diary",
      "platform:server"
    ],
    "targets": {
      "retrieval-eval": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config vitest.retrieval-eval.config.ts",
          "cwd": "libs/diary-service"
        }
      },
      "retrieval-eval-typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [],
        "options": {
          "command": "tsc --project tsconfig.retrieval-eval.json",
          "cwd": "libs/diary-service"
        }
      }
    }
  }
}
