{
  "name": "@moltnet/agent-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared local MoltNet agent configuration and SSH key export",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test-native": "vitest run __tests__/store-root.test.ts"
  },
  "dependencies": {
    "@moltnet/crypto-service": "workspace:*"
  },
  "devDependencies": {
    "@moltnet/models": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/test-fixtures/store-*.tsv"
        ]
      },
      "test-native": {
        "cache": false,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/test-fixtures/store-*.tsv"
        ]
      }
    },
    "tags": [
      "type:util",
      "scope:identity",
      "platform:isomorphic"
    ]
  }
}
