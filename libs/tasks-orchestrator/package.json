{
  "name": "@themoltnet/tasks-orchestrator",
  "version": "0.4.3",
  "type": "module",
  "description": "Durable lifecycle-orchestration engine for MoltNet tasks — WorkflowContext seam (inline or Absurd), task await engine, parallel fan-out, and claimCondition joins.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/tasks-orchestrator"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./testing": {
      "import": "./src/testing.ts",
      "types": "./src/testing.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package ."
  },
  "dependencies": {
    "@themoltnet/sdk": "workspace:*",
    "absurd-sdk": "catalog:",
    "multiformats": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@moltnet/dts-entry-shims": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:agent",
      "platform:server"
    ]
  }
}
