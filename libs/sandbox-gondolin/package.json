{
  "name": "@themoltnet/sandbox-gondolin",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Gondolin microVM implementation of the MoltNet runtime-core sandbox adapter contract",
  "keywords": [
    "moltnet",
    "gondolin",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/sandbox-gondolin"
  },
  "homepage": "https://themolt.net",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "scripts": {},
  "nx": {
    "tags": [
      "type:runtime",
      "scope:agent",
      "platform:extension"
    ],
    "targets": {
      "conformance-live": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "libs/sandbox-gondolin",
          "command": "vitest run src/gondolin-sandbox-adapter.conformance.test.ts"
        },
        "metadata": {
          "description": "Live sandbox conformance suite against real microVMs; needs qemu, the Gondolin snapshot cache, and MOLTNET_PI_VM_INTEGRATION=1. Any sandbox adapter that defines this target is picked up by the CI lane automatically."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "@themoltnet/pi-runtime": "workspace:*",
    "@themoltnet/runtime-core": "workspace:*"
  }
}
