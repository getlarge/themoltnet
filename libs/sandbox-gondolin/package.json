{
  "name": "@themoltnet/sandbox-gondolin",
  "version": "0.1.0",
  "description": "Gondolin microVM sandbox lifecycle for MoltNet runtimes: checkpoint resume, egress policy, VFS shadowing, guest credential boundary, host-brokered secrets",
  "keywords": [
    "moltnet",
    "gondolin",
    "sandbox",
    "microvm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/sandbox-gondolin"
  },
  "homepage": "https://themolt.net",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package ."
  },
  "nx": {
    "tags": [
      "type:runtime",
      "scope:agent",
      "platform:extension"
    ],
    "targets": {
      "test-ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "test"
        ]
      }
    }
  },
  "dependencies": {
    "@earendil-works/gondolin": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
