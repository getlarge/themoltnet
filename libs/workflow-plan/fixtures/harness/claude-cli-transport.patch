+async function callClaudeCli({ model, systemPrompt, userMessage, maxTokens }) {
+  const args = [
+    "-p", userMessage,
+    "--system-prompt", systemPrompt,
+    "--model", model,
+    "--output-format", "json",
+    "--max-turns", "1",
+    "--tools", "",
+  ];
+  const { stdout } = await execFileAsync(process.env.WINDAGS_CLAUDE_BIN ?? "claude", args, {
+    maxBuffer: 16 * 1024 * 1024,
+    env: { ...process.env, CLAUDECODE: undefined, CLAUDE_CODE_ENTRYPOINT: undefined },
+  });
+  const data = JSON.parse(stdout);
+  const text = typeof data.result === "string" ? data.result : "";
+  const servedModels = Object.keys(data.modelUsage ?? {});
+  return {
+    text,
+    usage: {
+      input_tokens: (data.usage?.input_tokens ?? 0) + (data.usage?.cache_creation_input_tokens ?? 0) + (data.usage?.cache_read_input_tokens ?? 0),
+      output_tokens: data.usage?.output_tokens ?? 0,
+      cost_usd: data.total_cost_usd ?? null,
+      served_models: servedModels,
+      max_tokens_requested: maxTokens,
+    },
+  };
+}
+
