{
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc",
    "rootDir": "./src",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "__tests__/**/*.spec.ts",
    "__tests__/**/*.spec.tsx",
    "__tests__/**/*.spec.js",
    "__tests__/**/*.spec.jsx"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../models/tsconfig.lib.json"
    },
    {
      "path": "../database/tsconfig.lib.json"
    },
    {
      "path": "../auth/tsconfig.lib.json"
    }
  ]
}
