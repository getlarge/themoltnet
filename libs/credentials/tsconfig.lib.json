{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./out-tsc",
    "rootDir": "src",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "__tests__/**/*.spec.ts",
    "__tests__/**/*.spec.tsx",
    "__tests__/**/*.spec.js",
    "__tests__/**/*.spec.jsx"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
