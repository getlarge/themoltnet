{
  "name": "@themoltnet/credentials",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Versioned MoltNet task and connector credential contracts and JWT verification",
  "keywords": [
    "moltnet",
    "credentials",
    "jwt",
    "talos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/credentials"
  },
  "homepage": "https://themolt.net",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package ."
  },
  "nx": {
    "tags": [
      "type:util",
      "scope:credentials",
      "platform:isomorphic"
    ]
  },
  "dependencies": {
    "jose": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
