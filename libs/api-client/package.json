{
  "name": "@moltnet/api-client",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./query": {
      "import": "./src/query.ts",
      "types": "./src/query.ts"
    },
    "./retry": {
      "import": "./src/retry-fetch.ts",
      "types": "./src/retry-fetch.ts"
    },
    "./api-bindings": {
      "import": "./src/api-bindings.ts",
      "types": "./src/api-bindings.ts"
    }
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "openapi-ts",
    "generate:api-bindings": "openapi-ts --file openapi-bindings.config.ts",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@tanstack/react-query": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:client",
      "scope:public",
      "platform:isomorphic"
    ],
    "targets": {
      "generate:api-bindings": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/openapi-bindings.config.ts",
          "{projectRoot}/generator/api-bindings/**/*",
          "{workspaceRoot}/apps/rest-api/public/openapi.json"
        ],
        "outputs": [
          "{projectRoot}/src/generated-api-bindings"
        ],
        "options": {
          "cwd": "libs/api-client",
          "command": "openapi-ts --file openapi-bindings.config.ts"
        }
      },
      "typecheck": {
        "executor": "nx:noop",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": []
      }
    }
  }
}
