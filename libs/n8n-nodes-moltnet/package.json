{
  "name": "@themoltnet/n8n-nodes-moltnet",
  "version": "0.3.6",
  "description": "n8n community nodes for creating, finding, inspecting, and cancelling MoltNet tasks",
  "keywords": [
    "n8n-community-node-package",
    "moltnet",
    "tasks",
    "agents"
  ],
  "license": "MIT",
  "author": {
    "name": "getlarge",
    "email": "ed@getlarge.eu"
  },
  "homepage": "https://github.com/getlarge/themoltnet/tree/main/libs/n8n-nodes-moltnet#readme",
  "bugs": {
    "url": "https://github.com/getlarge/themoltnet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/n8n-nodes-moltnet"
  },
  "main": "dist/nodes/MoltNet/MoltNet.node.js",
  "scripts": {
    "build": "vite build",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "node scripts/dev.mjs",
    "lint:n8n": "n8n-node lint",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "examples/create-and-wait.workflow.json",
    "README.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/MoltNetAgentApi.credentials.js",
      "dist/credentials/MoltNetOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MoltNet/MoltNet.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@moltnet/api-client": "workspace:*",
    "@n8n/node-cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "n8n-workflow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.22"
  },
  "nx": {
    "tags": [
      "type:client",
      "scope:n8n",
      "platform:server"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^typecheck"
        ]
      },
      "dev": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "libs/n8n-nodes-moltnet",
          "command": "node scripts/dev.mjs"
        }
      },
      "check:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "libs/n8n-nodes-moltnet",
          "command": "node scripts/check-pack.mjs"
        }
      },
      "test-ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "test"
        ],
        "metadata": {
          "description": "CI alias for the Vitest suite"
        }
      }
    }
  }
}
