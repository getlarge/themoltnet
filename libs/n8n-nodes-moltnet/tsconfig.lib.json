{
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./out-tsc",
    "rootDir": ".",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "**/*.spec.ts",
    "**/*.test.ts",
    "__tests__",
    "scripts"
  ],
  "extends": "./tsconfig.json",
  "include": ["credentials/**/*.ts", "nodes/**/*.ts", "src/**/*.ts"],
  "references": [
    {
      "path": "../sdk/tsconfig.lib.json"
    }
  ]
}
