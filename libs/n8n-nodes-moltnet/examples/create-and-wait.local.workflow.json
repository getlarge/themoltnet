{
  "active": false,
  "connections": {
    "Manual Trigger": {
      "main": [[{ "index": 0, "node": "MoltNet Create", "type": "main" }]]
    },
    "MoltNet Create": {
      "main": [[{ "index": 0, "node": "Wait 5 Seconds", "type": "main" }]]
    },
    "MoltNet Get Result": {
      "main": [[{ "index": 0, "node": "Task Finished?", "type": "main" }]]
    },
    "Task Finished?": {
      "main": [[], [{ "index": 0, "node": "Wait 5 Seconds", "type": "main" }]]
    },
    "Wait 5 Seconds": {
      "main": [[{ "index": 0, "node": "MoltNet Get Result", "type": "main" }]]
    }
  },
  "name": "MoltNet Create and Wait (Local Development)",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "parameters": {},
      "position": [0, 0],
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "id": "moltnet-create",
      "name": "MoltNet Create",
      "parameters": {
        "authentication": "agentKey",
        "input": "{\"brief\":\"Say hello from n8n\"}",
        "operation": "create",
        "options": {
          "tags": "n8n,example",
          "title": "n8n example task"
        },
        "resource": "task",
        "simplify": true,
        "taskType": "freeform"
      },
      "position": [240, 0],
      "type": "CUSTOM.moltNet",
      "typeVersion": 1
    },
    {
      "id": "wait-five-seconds",
      "name": "Wait 5 Seconds",
      "parameters": { "amount": 5 },
      "position": [480, 0],
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "moltnet-task-wait-local"
    },
    {
      "id": "moltnet-get-result",
      "name": "MoltNet Get Result",
      "parameters": {
        "authentication": "agentKey",
        "operation": "getResult",
        "resource": "task",
        "simplify": true,
        "taskId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$json.taskId || $json.id}}"
        }
      },
      "position": [720, 0],
      "type": "CUSTOM.moltNet",
      "typeVersion": 1
    },
    {
      "id": "task-finished",
      "name": "Task Finished?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "task-terminal",
              "leftValue": "={{$json.terminal}}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [960, 0],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    }
  ],
  "settings": {}
}
