{
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist/typecheck",
    "rootDir": ".",
    "tsBuildInfoFile": "./dist/typecheck/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "__tests__",
    "scripts"
  ],
  "extends": "./tsconfig.json",
  "include": ["credentials/**/*.ts", "nodes/**/*.ts", "vendor/**/*.ts"]
}
