{
  "name": "@themoltnet/credential-broker",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "description": "Provider-neutral MoltNet task and connector credential broker",
  "keywords": [
    "moltnet",
    "credential-broker",
    "talos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/credential-broker"
  },
  "homepage": "https://themolt.net",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package ."
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:credentials",
      "platform:server"
    ]
  },
  "dependencies": {
    "@themoltnet/credentials": "workspace:*",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
