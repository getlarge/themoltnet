{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./out-tsc",
    "rootDir": "src",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "references": []
}
