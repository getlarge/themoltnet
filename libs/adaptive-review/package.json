{
  "name": "@moltnet/adaptive-review",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Classifier-first advisory pull request review",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./main": {
      "import": "./src/main.ts",
      "types": "./src/main.ts"
    },
    "./publish": {
      "import": "./src/publish.ts",
      "types": "./src/publish.ts"
    },
    "./outcomes": {
      "import": "./src/outcomes.ts",
      "types": "./src/outcomes.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "type:feature",
      "scope:agent",
      "platform:server"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/.github/runtime-profiles/*.json"
        ]
      },
      "test-ci--__tests__/budget-contract.spec.ts": {
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          },
          "{workspaceRoot}/.github/runtime-profiles/*.json"
        ]
      }
    }
  },
  "dependencies": {
    "@moltnet/complexity-review": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/docs-impact-review": "workspace:*",
    "@moltnet/security-review": "workspace:*",
    "@moltnet/task-schemas": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@themoltnet/sdk": "workspace:*",
    "@themoltnet/tasks-orchestrator": "workspace:*",
    "re2js": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:",
    "absurd-sdk": "catalog:"
  }
}
