{
  "name": "@themoltnet/yubikey-preview-sign",
  "version": "0.3.0",
  "type": "module",
  "description": "Experimental YubiKey previewSign enrollment, ARKG derivation, signing, and offline verification",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./verify": {
      "import": "./src/verify-entry.ts",
      "types": "./src/verify-entry.ts"
    },
    "./protocol": {
      "import": "./src/protocol-entry.ts",
      "types": "./src/protocol-entry.ts"
    },
    "./test-support": {
      "import": "./src/arkg-test-support.ts",
      "types": "./src/arkg-test-support.ts"
    },
    "./vectors/preview-sign-v1.json": "./vectors/preview-sign-v1.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./verify": {
        "types": "./dist/verify.d.ts",
        "import": "./dist/verify.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      },
      "./vectors/preview-sign-v1.json": "./vectors/preview-sign-v1.json"
    }
  },
  "files": [
    "dist",
    "vectors",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package .",
    "check:verify-isolation": "tsx scripts/check-verify-isolation.ts"
  },
  "nx": {
    "tags": [
      "type:client",
      "scope:identity",
      "platform:server"
    ]
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@themoltnet/ctap": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/yubikey-preview-sign"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  }
}
