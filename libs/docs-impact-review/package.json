{
  "name": "@moltnet/docs-impact-review",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Documentation-impact PR reviewer: trusted ingestion and routing, then chained MoltNet tasks. Run in CI through packages/docs-impact-review-action.",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./review-cli": {
      "import": "./src/review-cli.ts",
      "types": "./src/review-cli.ts"
    },
    "./comment": {
      "import": "./src/comment.ts",
      "types": "./src/comment.ts"
    },
    "./eligibility": {
      "import": "./src/eligibility.ts",
      "types": "./src/eligibility.ts"
    }
  },
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint ."
  },
  "dependencies": {
    "@themoltnet/os-keyring": "workspace:*",
    "@themoltnet/sdk": "workspace:*",
    "@themoltnet/tasks-orchestrator": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "type:feature",
      "scope:agent",
      "platform:server"
    ]
  }
}
