{
  "name": "@moltnet/docs-impact-review",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Documentation-impact PR reviewer: trusted ingestion and routing, then chained MoltNet tasks. Runs as the docs lane of the adaptive review (libs/adaptive-review).",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./eligibility": {
      "import": "./src/eligibility.ts",
      "types": "./src/eligibility.ts"
    },
    "./github-api": {
      "import": "./src/github-api.ts",
      "types": "./src/github-api.ts"
    },
    "./workflow-command": {
      "import": "./src/workflow-command.ts",
      "types": "./src/workflow-command.ts"
    }
  },
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@moltnet/api-client": "workspace:*",
    "@moltnet/task-schemas": "workspace:*",
    "@themoltnet/tasks-orchestrator": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals"
      ]
    },
    "projectType": "library",
    "tags": [
      "type:feature",
      "scope:agent",
      "platform:server"
    ]
  }
}
