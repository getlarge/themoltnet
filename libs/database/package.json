{
  "name": "@moltnet/database",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "db:migrate:run": "tsx src/migrate-cli.ts",
    "db:status": "tsx src/migrate-status.ts",
    "dev": "tsc --watch -p tsconfig.lib.json"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "catalog:",
    "@dbos-inc/drizzle-datasource": "catalog:",
    "@moltnet/models": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "nx": {
    "release": {
      "docker": {
        "repositoryName": "getlarge/themoltnet/db-migrate"
      }
    },
    "tags": [
      "type:data-access",
      "scope:platform",
      "platform:server"
    ],
    "targets": {
      "docker:build": {
        "executor": "nx:run-commands",
        "cache": false,
        "inputs": [
          "dockerNodePackaging"
        ],
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/docker-build.mjs --project {projectName}"
        },
        "configurations": {
          "ci": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64 --no-cache-to --tag \"${NX_DOCKER_CI_TAG:?NX_DOCKER_CI_TAG must be set}\""
          },
          "release": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64,linux/arm64 --tag \"${NX_DOCKER_RELEASE_TAG:?NX_DOCKER_RELEASE_TAG must be set}\""
          }
        }
      },
      "docker:cache": {
        "executor": "nx:run-commands",
        "cache": false,
        "inputs": [
          "dockerNodePackaging"
        ],
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/docker-build.mjs --project {projectName} --cache-only --platform linux/amd64"
        }
      }
    }
  }
}
