{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "exclude": ["__tests__", "node_modules", "dist", "out-tsc", "e2e"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "drizzle.config.ts"],
  "references": [
    {
      "path": "../runtime-profiles/tsconfig.lib.json"
    },
    {
      "path": "../models/tsconfig.lib.json"
    }
  ]
}
