{
  "name": "@themoltnet/agent-runtime",
  "version": "0.44.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "MoltNet agent runtime — coding-agent-agnostic Task execution loop",
  "keywords": [
    "moltnet",
    "agent-runtime",
    "task-schemas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/agent-runtime"
  },
  "homepage": "https://themolt.net",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/.dts"
  ],
  "scripts": {
    "check:pack": "tsx ../../tools/src/check-pack.ts --package ."
  },
  "dependencies": {
    "@ipld/dag-cbor": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/ed25519": "catalog:",
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@themoltnet/sdk": "workspace:*",
    "multiformats": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/runtime-profiles": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "tags": [
      "type:runtime",
      "scope:agent",
      "platform:isomorphic"
    ],
    "targets": {
      "test-ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "test"
        ],
        "metadata": {
          "description": "Alias for `test` on projects without atomization."
        }
      }
    }
  }
}
