{
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-tsc",
    "rootDir": "./src",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../agent-config/tsconfig.lib.json" },
    { "path": "../agent-runtime/tsconfig.lib.json" },
    { "path": "../execution-plan/tsconfig.lib.json" },
    { "path": "../pi-runtime/tsconfig.lib.json" },
    { "path": "../runtime-execution/tsconfig.lib.json" },
    { "path": "../runtime-policy-service/tsconfig.lib.json" },
    { "path": "../sandbox-gondolin/tsconfig.lib.json" },
    { "path": "../sdk/tsconfig.lib.json" }
  ]
}
