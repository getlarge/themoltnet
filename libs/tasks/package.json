{
  "name": "@moltnet/tasks",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./context-recipes": {
      "import": "./src/runtime-profile-context-recipes.ts",
      "types": "./src/runtime-profile-context-recipes.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@moltnet/models": "workspace:*",
    "multiformats": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:util",
      "scope:task",
      "platform:isomorphic"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:noop",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": []
      }
    }
  }
}
