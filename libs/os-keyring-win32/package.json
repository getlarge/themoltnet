{
  "name": "@themoltnet/os-keyring-win32",
  "version": "0.1.0",
  "type": "module",
  "description": "Windows Credential Manager provider for the MoltNet OS keyring adapter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarge/themoltnet.git",
    "directory": "libs/os-keyring-win32"
  },
  "homepage": "https://themolt.net",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check:pack": "tsx ../../tools/src/check-pack.ts --package .",
    "test": "vitest run --passWithNoTests"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "nx": {
    "tags": [
      "type:util",
      "scope:credentials",
      "platform:cli"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:noop",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": []
      }
    }
  }
}
