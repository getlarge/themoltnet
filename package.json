{
  "name": "moltnet",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Infrastructure for AI agent autonomy",
  "repository": {
    "type": "git",
    "url": "https://github.com/getlarge/themoltnet"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "claude": "moltnet start claude --binding themoltnet",
    "commitlint": "commitlint",
    "codex": "moltnet start codex --binding themoltnet",
    "pi": "moltnet start pi",
    "build": "nx run-many -t build",
    "build:cli": "go build -o dist/moltnet ./apps/moltnet-cli",
    "go:build": "go build -o dist/moltnet ./apps/moltnet-cli",
    "go:test": "go test github.com/getlarge/themoltnet/apps/moltnet-cli/... && go test github.com/getlarge/themoltnet/libs/moltnet-api-client/...",
    "go:vet": "go vet github.com/getlarge/themoltnet/apps/moltnet-cli/... && go vet github.com/getlarge/themoltnet/libs/moltnet-api-client/...",
    "go:fmt": "gofmt -w apps/moltnet-cli/ libs/moltnet-api-client/",
    "go:fmt:check": "test -z \"$(gofmt -l apps/moltnet-cli/ libs/moltnet-api-client/)\"",
    "go:lint": "pnpm run go:vet && pnpm exec nx run-many -t lint --projects=tag:lang:go",
    "go:generate": "go generate ./libs/moltnet-api-client/...",
    "postinstall": "node tools/postinstall.mjs",
    "dev:mcp": "npx dotenvx run --env-file .env.local -- pnpm exec nx run @moltnet/mcp-server:dev",
    "dev:api": "npx dotenvx run --env-file .env.local -- pnpm exec nx run @moltnet/rest-api:dev",
    "dev:console": "npx dotenvx run --env-file .env.local -- pnpm exec nx run @moltnet/console:dev",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "db:generate": "pnpm exec nx run @moltnet/database:generate",
    "db:migrate": "pnpm exec nx run @moltnet/database:migrate",
    "db:migrate:run": "pnpm exec nx run @moltnet/database:db:migrate:run",
    "db:push": "pnpm exec nx run @moltnet/database:push",
    "db:status": "pnpm exec nx run @moltnet/database:db:status",
    "db:studio": "pnpm exec nx run @moltnet/database:studio",
    "clean": "find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -not -path '*/.worktrees/*' -not -path '*/.claude/*' -delete && find . -path '*/dist' -not -path '*/node_modules/*' -not -path '*/.worktrees/*' -not -path '*/.claude/*' -prune -exec rm -rf {} +",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:clean": "pnpm run clean && pnpm run typecheck",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "audit": "pnpm audit --prod",
    "generate:openapi": "tsx apps/rest-api/scripts/generate-openapi.ts",
    "generate:signer-openapi": "pnpm exec nx run @themoltnet/signer:generate:openapi",
    "generate:agent-server-openapi": "pnpm exec nx run @themoltnet/agent-daemon:generate:openapi",
    "ory:backup": "node infra/ory/backup.mjs",
    "generate:client": "pnpm exec nx run @moltnet/api-client:generate",
    "generate:api-bindings": "pnpm exec nx run @moltnet/api-client:generate:api-bindings",
    "generate:signer-client": "pnpm exec nx run @moltnet/signer-api-client:generate",
    "generate:agent-daemon-client": "pnpm exec nx run @moltnet/agent-daemon-api-client:generate",
    "generate": "pnpm run generate:openapi && pnpm run generate:signer-openapi && pnpm run generate:agent-server-openapi && pnpm run generate:client && pnpm run generate:api-bindings && pnpm run generate:signer-client && pnpm run generate:agent-daemon-client && pnpm run go:generate && pnpm run go:fmt",
    "check:pack": "pnpm exec nx run-many -t check:pack",
    "check:actionlint": "github-actionlint -shellcheck= -pyflakes= .github/workflows/*.yml",
    "renovate:create-app": "node tools/create-renovate-app.mjs",
    "check:quickstart": "pnpm exec nx run @moltnet/tools:check-quickstart",
    "check:vite-aliases": "tsx tools/src/check-vite-alias-exports.ts",
    "check:axiom": "node infra/axiom/validate.mjs",
    "validate": "pnpm run lint && pnpm run secretlint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:pack && pnpm run check:quickstart && pnpm run check:vite-aliases && pnpm run check:axiom",
    "docker:up": "docker compose --env-file .env.local up -d",
    "docker:images": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t build --projects=@moltnet/database && NX_LOAD_DOT_ENV_FILES=false nx run otel-custom-collector:docker:build && docker compose --env-file .env.local build app-db-migrate",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "e2e:build": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t docker:build --projects=@moltnet/rest-api,@moltnet/mcp-server,@moltnet/console,@moltnet/mcp-host,@moltnet/database",
    "e2e:up": "pnpm run e2e:build && COMPOSE_DISABLE_ENV_FILE=true docker compose -f docker-compose.e2e.yaml up -d",
    "e2e:down": "COMPOSE_DISABLE_ENV_FILE=true docker compose -f docker-compose.e2e.yaml down -v",
    "e2e:reset": "pnpm run e2e:down && pnpm run e2e:up",
    "test:e2e": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t e2e --projects=tag:type:e2e",
    "bootstrap": "pnpm --filter @moltnet/tools bootstrap",
    "prepare": "node tools/prepare.mjs",
    "secretlint": "nx run-many -t secretlint"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@eslint/js": "catalog:",
    "@nx-go/nx-go": "catalog:",
    "@nx/devkit": "catalog:",
    "@nx/docker": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/playwright": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/vitest": "catalog:",
    "@nx/web": "catalog:",
    "@playwright/test": "catalog:",
    "@secretlint/secretlint-rule-azure": "catalog:",
    "@secretlint/secretlint-rule-pattern": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "github-actionlint": "1.7.12",
    "globals": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-sort-json": "catalog:",
    "secretlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
