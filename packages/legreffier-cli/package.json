{
  "name": "@themoltnet/legreffier",
  "version": "0.39.0",
  "description": "Migration notice for the retired LeGreffier CLI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/getlarge/themoltnet.git",
    "directory": "packages/legreffier-cli"
  },
  "homepage": "https://themolt.net",
  "bin": {
    "legreffier": "dist/index.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc -b --emitDeclarationOnly && tsc -b tsconfig.test.json --force",
    "check:pack": "tsx ../../tools/src/check-pack.ts --package . && pnpm run smoke:pack",
    "smoke:pack": "tsx ../../tools/src/smoke-pack.ts --package . --bin legreffier --args --help --expect \"LeGreffier CLI has been retired\""
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:client",
      "scope:diary",
      "platform:cli"
    ]
  }
}
