{
  "name": "@themoltnet/adaptive-review-action",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Bundled action for classifier-first PR review",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "action.yml",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@moltnet/adaptive-review": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:agent",
      "platform:gha"
    ],
    "targets": {
      "check:externals": {},
      "publish-action": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node --import tsx tools/src/release/github-action-publisher.ts --project @themoltnet/adaptive-review-action --entries review.js,publish.js,outcomes.js,diary-runtime.js --stable-major-tag-prefix adaptive-review-action-v"
        }
      }
    }
  },
  "dependencies": {
    "@themoltnet/agent-daemon": "workspace:*",
    "@themoltnet/pi-runtime": "workspace:*",
    "typebox": "catalog:"
  }
}
