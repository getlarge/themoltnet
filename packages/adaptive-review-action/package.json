{
  "name": "@themoltnet/adaptive-review-action",
  "version": "0.1.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Bundled action for classifier-first PR review",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "action.yml",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint src/",
    "typecheck": "tsc -b --emitDeclarationOnly"
  },
  "devDependencies": {
    "@moltnet/adaptive-review": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:agent",
      "platform:gha"
    ],
    "targets": {
      "check:externals": {},
      "publish-action": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node --import tsx tools/src/release/github-action-publisher.ts --project @themoltnet/adaptive-review-action --entries review.js,publish.js,outcomes.js --stable-major-tag-prefix adaptive-review-action-v"
        }
      }
    }
  }
}
