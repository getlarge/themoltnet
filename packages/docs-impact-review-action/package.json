{
  "name": "@themoltnet/docs-impact-review-action",
  "version": "0.5.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "GitHub composite Action that reviews a pull request's documentation impact with chained MoltNet tasks. Distributed via repo tag (uses: getlarge/themoltnet/packages/docs-impact-review-action@docs-impact-review-action-v0), not via npm.",
  "files": [
    "action.yml",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@moltnet/docs-impact-review": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "{workspaceRoot}/.github/workflows/docs-impact-review-reusable.yml",
        "{workspaceRoot}/.github/workflows/docs-impact-review.yml",
        "{workspaceRoot}/.github/workflows/complexity-review-reusable.yml",
        "{workspaceRoot}/.github/runtime-profiles/**/*",
        "{workspaceRoot}/.github/runtime-policies/legreffier-review-readonly-v1.json"
      ]
    },
    "targets": {
      "publish-action": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          {
            "projects": [
              "@themoltnet/agent-daemon-action"
            ],
            "target": "build"
          }
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node --import tsx tools/src/release/github-action-publisher.ts --project @themoltnet/docs-impact-review-action --entries prepare.js,check.js,review.js,comment.js --stable-major-tag-prefix docs-impact-review-action-v --also-include @themoltnet/agent-daemon-action"
        }
      },
      "check:externals": {},
      "test": {
        "dependsOn": [
          "build"
        ]
      },
      "test-ci--src/action.test.ts": {
        "dependsOn": [
          "build"
        ]
      }
    },
    "tags": [
      "type:app",
      "scope:agent",
      "platform:gha"
    ]
  }
}
