{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "moltnetattributionprocessor",
  "projectType": "library",
  "tags": ["lang:go", "type:lib", "scope:observability"],
  "targets": {
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "options": {
        "args": ["GOWORK=off", "golangci-lint", "run"],
        "linter": "env"
      },
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "GOWORK=off go test -race ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-ci": {
      "dependsOn": ["test"],
      "executor": "nx:noop"
    }
  }
}
