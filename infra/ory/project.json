{
  "cors_public": {
    "allowed_headers": [
      "Authorization",
      "Content-Type",
      "X-Session-Token",
      "X-CSRF-Token",
      "Cookie"
    ],
    "enabled": false,
    "exposed_headers": ["Content-Type"],
    "origins": [
      "${LANDING_BASE_URL}",
      "${CONSOLE_BASE_URL}",
      "${DOCS_BASE_URL}",
      "${ORY_PROJECT_URL}"
    ]
  },
  "name": "MoltNet",
  "services": {
    "identity": {
      "config": {
        "cookies": {
          "same_site": "Lax"
        },
        "courier": {
          "smtp": {
            "connection_uri": "${SMTP_CONNECTION_URI}",
            "from_address": "${SMTP_FROM_ADDRESS}",
            "from_name": "LeGreffier"
          }
        },
        "identity": {
          "default_schema_id": "moltnet_human",
          "schemas": [
            {
              "id": "moltnet_agent",
              "url": "base64://${IDENTITY_SCHEMA_AGENT_BASE64}"
            },
            {
              "id": "moltnet_human",
              "url": "base64://${IDENTITY_SCHEMA_HUMAN_BASE64}"
            }
          ]
        },
        "selfservice": {
          "allowed_return_urls": [
            "${LANDING_BASE_URL}/",
            "${API_BASE_URL}/",
            "${CONSOLE_BASE_URL}/",
            "${DOCS_BASE_URL}/",
            "${ORY_PROJECT_URL}/oauth2/sessions/logout"
          ],
          "default_browser_return_url": "${CONSOLE_BASE_URL}/",
          "flows": {
            "error": {
              "ui_url": "${CONSOLE_BASE_URL}/auth/error"
            },
            "login": {
              "after": {
                "oidc": {
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": false,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": false
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-login"
                      },
                      "hook": "web_hook"
                    }
                  ]
                },
                "password": {
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": false,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": false
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-login"
                      },
                      "hook": "web_hook"
                    }
                  ]
                }
              },
              "lifespan": "1h",
              "ui_url": "${CONSOLE_BASE_URL}/auth/login"
            },
            "logout": {
              "after": {
                "default_browser_return_url": "${CONSOLE_BASE_URL}/"
              }
            },
            "recovery": {
              "enabled": true,
              "ui_url": "${CONSOLE_BASE_URL}/auth/recovery"
            },
            "registration": {
              "after": {
                "oidc": {
                  "default_browser_return_url": "${CONSOLE_BASE_URL}/auth/login",
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": true,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": true
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-registration"
                      },
                      "hook": "web_hook"
                    }
                  ]
                },
                "password": {
                  "default_browser_return_url": "${CONSOLE_BASE_URL}/auth/login",
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": true,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": true
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-registration"
                      },
                      "hook": "web_hook"
                    }
                  ]
                }
              },
              "enabled": true,
              "lifespan": "1h",
              "ui_url": "${CONSOLE_BASE_URL}/auth/registration"
            },
            "settings": {
              "after": {
                "password": {
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": true,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": true
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/validate-settings"
                      },
                      "hook": "web_hook"
                    },
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": false,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": false
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-settings"
                      },
                      "hook": "web_hook"
                    }
                  ]
                },
                "profile": {
                  "hooks": [
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": true,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": true
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/validate-settings"
                      },
                      "hook": "web_hook"
                    },
                    {
                      "config": {
                        "auth": {
                          "config": {
                            "in": "header",
                            "name": "X-Ory-Api-Key",
                            "value": "${ORY_ACTION_API_KEY}"
                          },
                          "type": "api_key"
                        },
                        "body": "base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5OiBjdHguaWRlbnRpdHkgfQ==",
                        "can_interrupt": false,
                        "method": "POST",
                        "response": {
                          "ignore": false,
                          "parse": false
                        },
                        "url": "${API_BASE_URL}/hooks/kratos/after-settings"
                      },
                      "hook": "web_hook"
                    }
                  ]
                }
              },
              "lifespan": "1h",
              "privileged_session_max_age": "15m",
              "ui_url": "${CONSOLE_BASE_URL}/auth/settings"
            },
            "verification": {
              "enabled": true,
              "ui_url": "${CONSOLE_BASE_URL}/auth/verification"
            }
          },
          "methods": {
            "code": {
              "config": {
                "lifespan": "15m"
              },
              "enabled": true
            },
            "link": {
              "config": {
                "base_url": "${ORY_PROJECT_URL}/",
                "lifespan": "15m"
              },
              "enabled": false
            },
            "oidc": {
              "config": {
                "base_redirect_uri": "${ORY_PROJECT_URL}",
                "providers": [
                  {
                    "client_id": "${SELFSERVICE_OIDC_GITHUB_CLIENT_ID}",
                    "client_secret": "${SELFSERVICE_OIDC_GITHUB_CLIENT_SECRET}",
                    "id": "github",
                    "label": "GitHub",
                    "mapper_url": "base64://bG9jYWwgY2xhaW1zID0gc3RkLmV4dFZhcignY2xhaW1zJyk7CnsKICBpZGVudGl0eTogewogICAgdHJhaXRzOiB7CiAgICAgIHVzZXJuYW1lOiBjbGFpbXMubmlja25hbWUsCiAgICB9ICsgKGlmICdlbWFpbCcgaW4gY2xhaW1zICYmIGNsYWltcy5lbWFpbF92ZXJpZmllZCB0aGVuIHsgZW1haWw6IGNsYWltcy5lbWFpbCB9IGVsc2Uge30pLAogIH0sCn0K",
                    "provider": "github",
                    "scope": ["user:email"]
                  }
                ]
              },
              "enabled": true
            },
            "passkey": {
              "config": {
                "rp": {
                  "display_name": "MoltNet",
                  "id": "auth.${BASE_DOMAIN}",
                  "origins": [
                    "${LANDING_BASE_URL}",
                    "${CONSOLE_BASE_URL}",
                    "${ORY_PROJECT_URL}"
                  ]
                }
              },
              "enabled": true
            },
            "password": {
              "config": {
                "haveibeenpwned_enabled": true,
                "identifier_similarity_check_enabled": false,
                "min_password_length": 16
              },
              "enabled": true
            },
            "profile": {
              "enabled": true
            },
            "saml": {
              "config": {
                "providers": []
              },
              "enabled": false
            },
            "totp": {
              "config": {
                "issuer": "MoltNet"
              },
              "enabled": true
            }
          }
        },
        "session": {
          "cookie": {
            "http_only": true,
            "same_site": "Lax",
            "secure": true
          },
          "lifespan": "720h"
        }
      }
    },
    "oauth2": {
      "config": {
        "oauth2": {
          "client_credentials": {
            "default_grant_allowed_scope": true
          },
          "grant": {
            "jwt": {
              "iat_optional": false,
              "jti_optional": false,
              "max_ttl": "2h"
            },
            "refresh_token": {
              "rotation_grace_period": "60s"
            }
          },
          "pkce": {
            "enforced": false,
            "enforced_for_public_clients": true
          },
          "token_hook": {
            "auth": {
              "config": {
                "in": "header",
                "name": "X-Ory-Api-Key",
                "value": "${ORY_ACTION_API_KEY}"
              },
              "type": "api_key"
            },
            "url": "${API_BASE_URL}/hooks/hydra/token-exchange"
          }
        },
        "oidc": {
          "dynamic_client_registration": {
            "default_scope": [
              "openid",
              "offline",
              "offline_access",
              "agent:profile",
              "crypto:sign",
              "diary:manage",
              "diary:read",
              "diary:write",
              "human:profile",
              "pack:read",
              "pack:write",
              "task:execute",
              "task:manage",
              "task:read",
              "task:write",
              "team:join",
              "team:manage",
              "team:read"
            ],
            "enabled": true
          },
          "subject_identifiers": {
            "pairwise": {
              "salt": "${OIDC_PAIRWISE_SALT}"
            },
            "supported_types": ["public"]
          }
        },
        "strategies": {
          "access_token": "opaque",
          "jwt": {},
          "scope": "wildcard"
        },
        "ttl": {
          "access_token": "24h",
          "auth_code": "10m",
          "id_token": "1h",
          "login_consent_request": "30m",
          "refresh_token": "720h"
        },
        "urls": {
          "consent": "${API_BASE_URL}/oauth2/consent",
          "error": "${CONSOLE_BASE_URL}/auth/error",
          "login": "${CONSOLE_BASE_URL}/auth/login",
          "logout": "${CONSOLE_BASE_URL}/auth/logout",
          "post_logout_redirect": "${CONSOLE_BASE_URL}/",
          "registration": "${CONSOLE_BASE_URL}/auth/registration",
          "self": {
            "issuer": "${ORY_PROJECT_URL}"
          }
        },
        "webfinger": {
          "oidc_discovery": {
            "client_registration_url": "${ORY_PROJECT_URL}/oauth2/register",
            "supported_scope": [
              "agent:profile",
              "crypto:sign",
              "diary:manage",
              "diary:read",
              "diary:write",
              "email",
              "human:profile",
              "pack:read",
              "pack:write",
              "profile",
              "task:execute",
              "task:manage",
              "task:read",
              "task:write",
              "team:join",
              "team:manage",
              "team:read"
            ],
            "token_url": "${API_BASE_URL}/oauth2/token"
          }
        }
      }
    },
    "permission": {
      "config": {}
    }
  }
}
