{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "commitHourlyLimit": 1,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+renovate-version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "dependencyDashboard": true,
  "draftPR": true,
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "description": "Major updates require an explicit dashboard decision",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "One reviewed minor-update PR per manager",
      "groupName": "{{manager}} minor updates",
      "matchUpdateTypes": ["minor"]
    },
    {
      "description": "Keep routine patches and initial pins together by manager",
      "groupName": "{{manager}} patch and pin updates",
      "matchUpdateTypes": ["patch", "pin", "digest", "pinDigest"]
    },
    {
      "description": "Let new patch releases settle before proposing them",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "automerge": false,
      "description": "Review workflow changes as one PR",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Pin existing workflow refs promptly, then review future updates weekly",
      "groupName": "GitHub Actions SHA pins",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "schedule": ["at any time"]
    },
    {
      "description": "Pin Dockerfile bases separately from version updates",
      "groupName": "Dockerfile base digest pins",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["pinDigest"],
      "schedule": ["at any time"]
    },
    {
      "description": "Keep Node.js tool-version files in one update",
      "groupName": "Node.js toolchain",
      "matchDepNames": ["node", "nodejs"],
      "matchManagers": ["nvm", "asdf"]
    },
    {
      "automerge": false,
      "description": "Require review for authentication and cryptography dependencies",
      "matchPackageNames": ["@ory/**", "@noble/**", "*sodium*", "jose"]
    }
  ],
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 1,
  "schedule": ["* 0-6 * * 1"],
  "timezone": "Europe/Paris",
  "vulnerabilityAlerts": {
    "draftPR": false,
    "enabled": true,
    "prConcurrentLimit": 2
  }
}
