{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "commitHourlyLimit": 1,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+renovate-version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "dependencyDashboard": true,
  "draftPR": true,
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "description": "Major updates require an explicit dashboard decision",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Let new patch releases settle before proposing them",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep Nx core and plugins on the same version",
      "groupName": "Nx workspace",
      "matchManagers": ["npm"],
      "matchPackageNames": ["nx", "@nx/**"]
    },
    {
      "description": "Review compatible Vite build-tool updates together; approve major migrations separately",
      "groupName": "Vite build tools",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "vite-plugin-dts",
        "vite-plugin-singlefile"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "allowedVersions": "<9.0.0",
      "description": "Nx 22 supports Vite 5 through 8",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite"]
    },
    {
      "description": "Keep Vitest and its official companion packages aligned",
      "groupName": "Vitest",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/**"]
    },
    {
      "allowedVersions": "<5.0.0",
      "description": "Nx 22 supports Vitest 3 and 4; review a newer major with Nx compatibility first",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/**"]
    },
    {
      "allowedVersions": "<5.10.0",
      "description": "Nx 22 supports TypeScript 5.4 through 5.9",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"]
    },
    {
      "description": "Review Fastify and plugin updates together without bundling unrelated major migrations",
      "groupName": "Fastify",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "fastify",
        "fastify-plugin",
        "@fastify/**",
        "@getlarge/fastify-mcp",
        "@scalar/fastify-api-reference"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Keep React runtime and type declarations aligned",
      "groupName": "React",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "description": "Review React companion tooling with routine React updates",
      "groupName": "React",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@testing-library/react",
        "eslint-plugin-react-hooks"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "automerge": false,
      "description": "Review workflow changes as one PR",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Pin existing workflow refs promptly, then review future updates weekly",
      "groupName": "GitHub Actions SHA pins",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "schedule": ["at any time"]
    },
    {
      "description": "Pin Dockerfile bases separately from version updates",
      "groupName": "Dockerfile base digest pins",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["pinDigest"],
      "schedule": ["at any time"]
    },
    {
      "description": "Keep Node.js tool-version files in one update",
      "groupName": "Node.js toolchain",
      "matchDepNames": ["node", "nodejs"],
      "matchManagers": ["nvm", "asdf"]
    },
    {
      "automerge": false,
      "description": "Require review for authentication and cryptography dependencies",
      "matchPackageNames": ["@ory/**", "@noble/**", "*sodium*", "jose"]
    }
  ],
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 1,
  "schedule": ["* 0-6 * * 1"],
  "timezone": "Europe/Paris",
  "vulnerabilityAlerts": {
    "draftPR": false,
    "enabled": true,
    "prConcurrentLimit": 2
  }
}
