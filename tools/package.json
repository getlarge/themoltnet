{
  "name": "@moltnet/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI tools for MoltNet operations (bootstrap, admin, etc.)",
  "generators": "./generators.json",
  "scripts": {
    "bootstrap": "tsx src/bootstrap-genesis-agents.ts",
    "check-secrets": "tsx src/check-secrets.ts",
    "check-quickstart": "node --import tsx src/check-quickstart-drift.ts",
    "download-model": "node download-embedding-model.mjs",
    "eval:setup": "tsx src/eval-setup.ts",
    "eval:teardown": "tsx src/eval-setup.ts --teardown",
    "talos:probe": "tsx src/talos-capability-probe.ts",
    "task:bootstrap-local": "tsx src/tasks/bootstrap-local-agent.ts",
    "bench:ory": "tsx src/bench-ory-connection-reuse.ts",
    "bench:embedding": "tsx src/bench-embedding-warmup.ts",
    "bench:task-readiness": "tsx src/bench-task-readiness.ts",
    "smtp:test": "tsx src/test-smtp.ts",
    "test:agent-bundle": "node --test __tests__/release/agent-bundle/agent-bundle.spec.mjs __tests__/release/cli/install.spec.mjs __tests__/release/cli/p12-chain.spec.mjs __tests__/release/sync-cli-consumer-pins.spec.mjs __tests__/release/sync-daemon-consumer-pins.spec.mjs __tests__/release/sync-adaptive-review-consumer-pins.spec.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@moltnet/auth": "workspace:*",
    "@moltnet/bootstrap": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/database": "workspace:*",
    "@moltnet/discovery": "workspace:*",
    "@moltnet/embedding-service": "workspace:*",
    "@moltnet/mcp-server": "workspace:*",
    "@moltnet/models": "workspace:*",
    "@moltnet/rest-api": "workspace:*",
    "@moltnet/runtime-profiles": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@ory/client-fetch": "catalog:",
    "@themoltnet/agent-runtime": "workspace:*",
    "@themoltnet/github-agent": "workspace:*",
    "@themoltnet/pi-extension": "workspace:*",
    "@themoltnet/pi-runtime": "workspace:*",
    "@themoltnet/sandbox-gondolin": "workspace:*",
    "@themoltnet/sdk": "workspace:*",
    "@zip.js/zip.js": "catalog:",
    "drizzle-orm": "catalog:",
    "fastq": "catalog:",
    "jose": "catalog:",
    "smol-toml": "catalog:",
    "tar": "catalog:",
    "typebox": "catalog:",
    "undici": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/chord": "catalog:",
    "@nx/devkit": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "es-module-lexer": "catalog:",
    "ignore": "catalog:",
    "json5": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.github/actions/**/*",
        "{workspaceRoot}/.github/scripts/issue-triage*.mjs",
        "{workspaceRoot}/.github/actionlint.yaml",
        "{workspaceRoot}/renovate.json",
        "{workspaceRoot}/.tool-versions"
      ]
    },
    "tags": [
      "type:tool",
      "scope:tooling",
      "platform:cli"
    ],
    "targets": {
      "test:agent-bundle": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:agent-bundle"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/release/agent-bundle/**",
          "{workspaceRoot}/tools/release/cli/**",
          "{workspaceRoot}/tools/release/sync-cli-consumer-pins*.mjs",
          "{workspaceRoot}/tools/release/sync-daemon-consumer-pins*.mjs",
          "{workspaceRoot}/tools/release/sync-adaptive-review-consumer-pins*.mjs",
          "{workspaceRoot}/tools/__tests__/release/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/apps/agent-daemon/package.json",
          "{workspaceRoot}/apps/moltnet-cli/.goreleaser.yml",
          "{workspaceRoot}/.github/workflows/release.yml",
          "{workspaceRoot}/.github/workflows/issue-triage.yml",
          "{workspaceRoot}/.github/workflows/legreffier-security-review.yml",
          "{workspaceRoot}/.github/workflows/adaptive-review-reusable.yml",
          "{workspaceRoot}/.github/workflows/adaptive-review.yml",
          "{workspaceRoot}/.github/workflows/adaptive-review-outcomes.yml",
          "{workspaceRoot}/libs/sandbox-gondolin/src/snapshot.ts",
          "{workspaceRoot}/.tool-versions"
        ]
      },
      "codex-environment-gondolin": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "moltnet start node -- --import tsx tools/src/codex-environment/probe.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "bench:durable": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "tsx src/bench-durable-storage.ts",
          "cwd": "tools"
        }
      },
      "test-ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "test"
        ]
      }
    }
  }
}
