diff --git a/tests/unit/test_solo_mode/test_edge_case_persistence.py b/tests/unit/test_solo_mode/test_edge_case_persistence.py
new file mode 100644
index 0000000..343b969
--- /dev/null
+++ b/tests/unit/test_solo_mode/test_edge_case_persistence.py
@@ -0,0 +1,120 @@
+"""Generated edge cases are durable independently of corpus annotations."""
+import inspect
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch, Mock
+
+from flask import Flask
+from potato.solo_mode.config import parse_solo_mode_config
+from potato.solo_mode.manager import SoloModeManager
+from potato.solo_mode.phase_controller import SoloPhase
+from potato.solo_mode import routes
+
+
+class EdgeCasePersistenceTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.app_config = {
+            'solo_mode': {'enabled': True, 'labeling_models': [], 'state_dir': self.tmp.name},
+            'annotation_schemes': [{'name': 'relevance', 'annotation_type': 'radio',
+                                    'labels': ['Answers', 'Supports', 'Not relevant']}],
+        }
+        self.config = parse_solo_mode_config(self.app_config)
+        self.manager = SoloModeManager(self.config, self.app_config)
+        self.app = Flask(__name__)
+        self.app.secret_key = 'synthetic-test-only'
+        self.app.register_blueprint(routes.solo_mode_bp)
+        self.client = self.app.test_client()
+        with self.client.session_transaction() as session:
+            session['username'] = 'test-annotator'
+        self.get_manager = patch.object(routes, 'get_solo_mode_manager', return_value=self.manager)
+        self.get_manager.start()
+        self.addCleanup(lambda: self.get_manager.stop())
+
+    def generate(self):
+        endpoint = Mock()
+        endpoint.query.return_value = {'edge_cases': [
+            {'text': 'Query: owner? Content: migration service owns it.',
+             'boundary_labels': ['Answers', 'Supports'], 'difficulty_reason': 'scope',
+             'which_aspect': 'ownership'},
+            {'text': 'Query: owner? Content: only one process should migrate.',
+             'boundary_labels': ['Supports', 'Not relevant'], 'difficulty_reason': 'utility',
+             'which_aspect': 'support'},
+        ]}
+        self.manager.edge_case_synthesizer._synthesis_endpoint = endpoint
+        return self.manager.edge_case_synthesizer.synthesize_edge_cases('task', 'prompt', 2)
+
+    def reload(self):
+        restored = SoloModeManager(self.config, self.app_config)
+        self.assertTrue(restored.load_state())
+        return restored
+
+    def test_partial_label_is_saved_before_last_case(self):
+        cases = self.generate()
+        self.manager.phase_controller.transition_to(SoloPhase.EDGE_CASE_LABELING, force=True)
+        response = self.client.post('/solo/edge-cases', data={
+            'case_id': cases[0].id, 'label': 'Answers', 'notes': 'Names the owner.'})
+        self.assertEqual(response.status_code, 302)
+        restored = self.reload().edge_case_synthesizer
+        self.assertEqual(restored.to_dict(), self.manager.edge_case_synthesizer.to_dict())
+        self.assertEqual(len(restored.get_unlabeled_edge_cases()), 1)
+        self.assertEqual(restored.get_labeled_edge_cases()[0].labeler_notes, 'Names the owner.')
+        self.assertNotEqual(restored._generate_id(), cases[-1].id)
+
+    def test_generation_is_saved_before_labeling(self):
+        self.generate()
+        self.manager.phase_controller.transition_to(SoloPhase.EDGE_CASE_SYNTHESIS, force=True)
+        with patch.object(routes, 'render_template', return_value='form'):
+            response = self.client.get('/solo/edge-cases')
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(len(self.reload().edge_case_synthesizer.get_all_edge_cases()), 2)
+
+    def test_final_label_and_export_survive_reload(self):
+        cases = self.generate()
+        self.manager.phase_controller.transition_to(SoloPhase.EDGE_CASE_LABELING, force=True)
+        for case in cases:
+            response = self.client.post('/solo/edge-cases', data={'case_id': case.id, 'label': 'Supports'})
+            self.assertEqual(response.status_code, 302)
+        self.manager = self.reload()
+        self.get_manager.stop()
+        self.get_manager = patch.object(routes, 'get_solo_mode_manager', return_value=self.manager)
+        self.get_manager.start()
+        self.assertEqual(self.manager.get_current_phase(), SoloPhase.PROMPT_VALIDATION)
+        with self.app.test_request_context():
+            exported = inspect.unwrap(routes.api_export)().get_json()
+        self.assertEqual(exported['edge_case_synthesis'], self.manager.edge_case_synthesizer.to_dict())
+        self.assertEqual(len(self.manager.edge_case_synthesizer.get_labeled_edge_cases()), 2)
+
+    def test_legacy_state_without_cases_loads(self):
+        self.manager.create_prompt_version('legacy prompt', created_by='user_setup')
+        path = Path(self.tmp.name) / 'solo_mode_state.json'
+        state = json.loads(path.read_text())
+        state.pop('edge_case_synthesis', None)
+        path.write_text(json.dumps(state))
+        restored = self.reload()
+        self.assertEqual(restored.get_current_prompt_text(), 'legacy prompt')
+        self.assertEqual(restored.edge_case_synthesizer.get_all_edge_cases(), [])
+
+    def test_empty_generation_does_not_advance(self):
+        endpoint = Mock(); endpoint.query.return_value = {'edge_cases': [{'content': 'wrong field'}]}
+        self.manager.edge_case_synthesizer._synthesis_endpoint = endpoint
+        self.manager.phase_controller.transition_to(SoloPhase.EDGE_CASE_SYNTHESIS, force=True)
+        with patch.object(routes, 'render_template', return_value='retry') as render:
+            response = self.client.get('/solo/edge-cases')
+        self.assertEqual(response.status_code, 502)
+        self.assertIn('synthesis_error', render.call_args.kwargs)
+        self.assertEqual(self.manager.get_current_phase(), SoloPhase.EDGE_CASE_SYNTHESIS)
+
+    def test_unknown_case_or_label_is_rejected(self):
+        case = self.generate()[0]
+        for data,status in [({'case_id': 'missing', 'label': 'Answers'},404),
+                            ({'case_id': case.id, 'label': 'invented'},400)]:
+            self.assertEqual(self.client.post('/solo/edge-cases', data=data).status_code,status)
+        self.assertFalse(self.manager.edge_case_synthesizer.get_labeled_edge_cases())
+
+
+if __name__ == '__main__':
+    unittest.main()
