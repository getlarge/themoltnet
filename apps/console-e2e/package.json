{
  "name": "@moltnet/console-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@moltnet/api-client": "workspace:*",
    "@moltnet/bootstrap": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@playwright/test": "catalog:",
    "@ory/client-fetch": "catalog:",
    "@themoltnet/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:e2e",
      "scope:public",
      "platform:browser"
    ],
    "implicitDependencies": [
      "@moltnet/console"
    ],
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        {
          "env": "AUTH_UI_TESTS"
        },
        {
          "env": "AUTH_UI_MAIL_TESTS"
        },
        {
          "env": "AUTH_UI_OAUTH_TESTS"
        },
        {
          "env": "AUTH_UI_EXPIRY_TESTS"
        },
        {
          "env": "AUTH_UI_VISUAL_TESTS"
        }
      ]
    },
    "targets": {
      "e2e-auth": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/console-e2e",
          "command": "playwright test src/auth-self-service.e2e.spec.ts",
          "env": {
            "AUTH_UI_TESTS": "1",
            "AUTH_UI_MAIL_TESTS": "1"
          }
        }
      }
    }
  }
}
