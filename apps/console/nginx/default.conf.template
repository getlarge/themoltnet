server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime config injection — replaces VITE_* env vars at container start.
    # Never cache: config points at auth/API origins that must not be pinned to
    # a stale value in a user's browser.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, must-revalidate";
        # packGcTtlDays mirrors the rest-api's PACK_GC_COMPILE_TTL_DAYS so the
        # console computes the same retention window the server enforces. Quoted
        # so an unset var yields "" rather than invalid JS; the client parses it
        # and falls back. Set it from the same value as the API deployment.
        return 200 'window.__MOLTNET_CONFIG__={kratosUrl:"${KRATOS_PUBLIC_URL}",apiBaseUrl:"${API_BASE_URL}",consoleUrl:"${CONSOLE_BASE_URL}",signerUrl:"${SIGNER_BASE_URL}",serveUrl:"${MOLTNET_SERVE_URL}",packGcTtlDays:"${PACK_GC_COMPILE_TTL_DAYS}"};';
    }

    # Cache hashed assets immutably
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must always be revalidated. It is the unhashed entrypoint that
    # points at the immutable /assets/* bundle; if a browser pins a stale copy it
    # keeps loading the old (possibly broken) bundle for up to a year, and logout/
    # login cannot clear it. Forcing revalidation means a new deploy is picked up
    # on the next navigation. See the console auth-loop incident (#1747/#1765).
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Static error page — must not depend on SPA JS bundle
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        internal;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
