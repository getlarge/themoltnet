{
  "name": "@moltnet/console",
  "version": "0.11.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {},
  "dependencies": {
    "@moltnet/agent-daemon-api-client": "workspace:*",
    "@moltnet/api-client": "workspace:*",
    "@moltnet/diary-ui": "workspace:*",
    "@moltnet/models": "workspace:*",
    "@moltnet/provenance-ui": "workspace:*",
    "@moltnet/runtime-profiles": "workspace:*",
    "@moltnet/signer-api-client": "workspace:*",
    "@moltnet/task-ui": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@ory/client-fetch": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@themoltnet/design-system": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@moltnet/bootstrap": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/database": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^16.0.0",
    "@themoltnet/sdk": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "release": {
      "docker": {
        "repositoryName": "getlarge/themoltnet/console"
      }
    },
    "tags": [
      "type:app",
      "scope:public",
      "platform:browser"
    ],
    "targets": {
      "docker:build": {
        "executor": "nx:run-commands",
        "cache": false,
        "inputs": [
          "docker"
        ],
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/docker-build.mjs --project {projectName}"
        },
        "configurations": {
          "ci": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64 --no-cache-to --tag \"${NX_DOCKER_CI_TAG:?NX_DOCKER_CI_TAG must be set}\""
          },
          "release": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64,linux/arm64 --tag \"${NX_DOCKER_RELEASE_TAG:?NX_DOCKER_RELEASE_TAG must be set}\""
          }
        }
      }
    }
  }
}
