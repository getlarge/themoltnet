{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "outDir": "./out-tsc/spec",
    "rootDir": ".",
    "tsBuildInfoFile": "./out-tsc/tsconfig.spec.tsbuildinfo",
    "types": [
      "vitest",
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node"
    ]
  },
  "extends": "./tsconfig.json",
  "include": ["__tests__/**/*.ts", "__tests__/**/*.tsx", "src/**/*.d.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
