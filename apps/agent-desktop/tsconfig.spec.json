{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "outDir": "./out-tsc/spec",
    "rootDir": ".",
    "tsBuildInfoFile": "./out-tsc/tsconfig.spec.tsbuildinfo",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"]
  },
  "extends": "./tsconfig.json",
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
