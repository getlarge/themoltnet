{
  "app": {
    "security": {
      "capabilities": [
        "main-window",
        {
          "identifier": "desktop-e2e",
          "permissions": ["wdio:default", "wdio-webdriver:default"],
          "windows": ["main"]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "pnpm exec vite build --config e2e/vite.config.ts --mode native-e2e",
    "frontendDist": "../dist-e2e"
  },
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "identifier": "net.themolt.agent.e2e",
  "productName": "MoltNet Agent E2E"
}
