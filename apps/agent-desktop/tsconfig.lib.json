{
  "compilerOptions": {
    "composite": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./out-tsc",
    "rootDir": "./src",
    "tsBuildInfoFile": "./out-tsc/tsconfig.tsbuildinfo",
    "types": ["vite/client"]
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "extends": "./tsconfig.json",
  "include": ["src"],
  "references": [
    {
      "path": "../../libs/design-system/tsconfig.lib.json"
    },
    {
      "path": "../../libs/tasks/tsconfig.lib.json"
    },
    {
      "path": "../../libs/agent-daemon-api-client/tsconfig.lib.json"
    }
  ]
}
