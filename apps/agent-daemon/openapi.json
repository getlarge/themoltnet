                    "properties": {
                      "apiUrl": {
                        "format": "uri",
                        "type": "string"
                      },
                      "configDir": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": ["external"],
                        "type": "string"
                      }
                    },
                    "required": ["kind", "configDir"],
                    "type": "object"
                  }
                ],
                "properties": {
                  "kind": {
                    "anyOf": [
                      {
                        "enum": ["managed"],
                        "type": "string"
                      },
                      {
                        "enum": ["external"],
                        "type": "string"
                      }
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["kind", "name"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentServerAgent"
                }
              }
