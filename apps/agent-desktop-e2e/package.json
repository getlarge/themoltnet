{
  "name": "@moltnet/agent-desktop-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "catalog:",
    "@wdio/globals": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/tauri-plugin": "catalog:",
    "@wdio/tauri-service": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webdriverio": "catalog:",
    "tsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@axe-core/webdriverio": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:e2e",
      "scope:agent",
      "platform:desktop"
    ],
    "implicitDependencies": [
      "@moltnet/agent-desktop",
      "@themoltnet/agent-daemon"
    ],
    "targets": {
      "build-native": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/agent-desktop-e2e/build-native.mjs"
        }
      },
      "e2e": {
        "executor": "nx:run-commands",
        "cache": false,
        "parallelism": false,
        "options": {
          "commands": [
            "node apps/agent-desktop-e2e/build-native.mjs",
            "node apps/agent-desktop-e2e/run-native.mjs --docker"
          ],
          "parallel": false
        },
        "configurations": {
          "chrome": {
            "commands": [
              "pnpm --dir apps/agent-desktop-e2e exec wdio run wdio.chrome.conf.ts"
            ]
          },
          "docs-capture": {
            "commands": [
              "pnpm --dir apps/agent-desktop-e2e exec wdio run wdio.docs.conf.ts"
            ]
          },
          "native": {
            "commands": [
              "node apps/agent-desktop-e2e/build-native.mjs",
              "node apps/agent-desktop-e2e/run-native.mjs"
            ]
          }
        }
      }
    }
  },
  "dependencies": {
    "@moltnet/agent-desktop": "workspace:*",
    "@moltnet/bootstrap": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/models": "workspace:*",
    "@themoltnet/agent-daemon": "workspace:*",
    "@themoltnet/design-system": "workspace:*",
    "@themoltnet/sdk": "workspace:*"
  }
}
