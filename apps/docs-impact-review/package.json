{
  "name": "@moltnet/docs-impact-review",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Experimental documentation-impact PR reviewer: trusted ingestion and routing, then two chained MoltNet tasks.",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "moltnet-docs-impact-review": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "build": "vite build",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint ."
  },
  "dependencies": {
    "@themoltnet/os-keyring": "workspace:*",
    "@themoltnet/sdk": "workspace:*",
    "@themoltnet/tasks-orchestrator": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app",
      "scope:agent",
      "platform:cli"
    ]
  }
}
