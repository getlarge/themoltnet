{
  "name": "@themoltnet/orchestration-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@themoltnet/issue-lifecycle": "workspace:*",
    "@themoltnet/multi-lens-review": "workspace:*",
    "@themoltnet/tasks-orchestrator": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:e2e",
      "scope:agent",
      "platform:cli"
    ],
    "implicitDependencies": [
      "@themoltnet/issue-lifecycle",
      "@themoltnet/multi-lens-review",
      "@themoltnet/tasks-orchestrator"
    ],
    "targets": {
      "e2e": {
        "cache": false,
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/src/**/*",
          {
            "externalDependencies": [
              "vitest"
            ]
          }
        ],
        "options": {
          "command": "vitest run --config vitest.config.ts",
          "cwd": "apps/orchestration-e2e"
        },
        "outputs": []
      }
    }
  }
}
