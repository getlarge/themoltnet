{
  "name": "@themoltnet/agent-daemon-e2e",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@moltnet/agent-daemon-api-client": "workspace:*",
    "@moltnet/agent-eval": "workspace:*",
    "@moltnet/bootstrap": "workspace:*",
    "@moltnet/crypto-service": "workspace:*",
    "@moltnet/observability": "workspace:*",
    "@moltnet/runtime-profiles": "workspace:*",
    "@moltnet/tasks": "workspace:*",
    "@themoltnet/agent-daemon": "workspace:*",
    "@themoltnet/agent-runtime": "workspace:*",
    "@themoltnet/pi-extension": "workspace:*",
    "@themoltnet/sdk": "workspace:*",
    "@themoltnet/shell-command-analyzer": "workspace:*"
  },
  "devDependencies": {
    "@moltnet/models": "workspace:*",
    "@themoltnet/pi-runtime": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:e2e",
      "scope:agent",
      "platform:cli"
    ],
    "implicitDependencies": [
      "@themoltnet/agent-daemon"
    ],
    "targets": {
      "e2e": {
        "cache": true,
        "configurations": {
          "shard-1": {
            "args": [
              "--shard=1/2"
            ]
          },
          "shard-2": {
            "args": [
              "--shard=2/2"
            ]
          }
        },
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/evals-v2/**/*",
          "{projectRoot}/vitest.config.ts",
          "{projectRoot}/src/**/*",
          {
            "env": "MOLTNET_AGENT_DAEMON_LIVE_LLM_E2E"
          },
          {
            "env": "MOLTNET_AGENT_DAEMON_LIVE_MODEL"
          },
          {
            "env": "MOLTNET_BASELINE"
          },
          {
            "env": "BASELINE_REPEATS"
          },
          {
            "env": "MOLTNET_EVAL_MATRIX"
          },
          {
            "env": "MODELS"
          },
          {
            "env": "MOLTNET_EVAL_JUDGE_MODEL"
          },
          {
            "env": "MOLTNET_AB"
          },
          {
            "env": "AB_REPEATS"
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          }
        ],
        "options": {
          "command": "vitest run --config vitest.config.ts",
          "cwd": "apps/agent-daemon-e2e"
        },
        "outputs": []
      },
      "e2e:artifact-safety-ab": {
        "cache": false,
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/evals-v2/standard-engineering-artifact-safety/**/*",
          {
            "env": "MOLTNET_AB"
          },
          {
            "env": "AB_REPEATS"
          },
          {
            "env": "MOLTNET_AGENT_DAEMON_LIVE_MODEL"
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          }
        ],
        "options": {
          "command": "vitest run --config vitest.config.ts src/ab-artifact-safety.e2e.test.ts",
          "cwd": "apps/agent-daemon-e2e"
        },
        "outputs": []
      },
      "e2e:eval-matrix": {
        "cache": false,
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/evals-v2/**/*",
          {
            "env": "MOLTNET_EVAL_MATRIX"
          },
          {
            "env": "MODELS"
          },
          {
            "env": "MOLTNET_EVAL_JUDGE_MODEL"
          },
          {
            "env": "EVAL_MATRIX_OUT"
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          }
        ],
        "options": {
          "command": "vitest run --config vitest.config.ts src/eval-matrix.e2e.test.ts",
          "cwd": "apps/agent-daemon-e2e"
        },
        "outputs": []
      }
    }
  }
}
