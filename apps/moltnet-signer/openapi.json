          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "tags": [
          "signer"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local signer companion",
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "17373",
          "description": "Ephemeral or explicitly configured loopback port"
        }
      }
    }
  ]
}
