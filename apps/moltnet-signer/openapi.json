          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "security": [
          {
            "signerSession": []
          }
        ],
        "tags": [
          "signer"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "description": "Create a short-lived signer capability bound to the browser Origin header.",
        "operationId": "createSignerSession",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerSession"
                }
              }
            },
            "description": "Default Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
