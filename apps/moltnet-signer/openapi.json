  "info": {
    "description": "Private loopback protocol between MoltNet Console and the local signer companion.",
    "title": "MoltNet signer companion API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/ceremonies": {
      "post": {
        "description": "Create an enrollment or previewSign ceremony for explicit local approval.",
        "operationId": "createSignerCeremony",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignerCeremonyRequest"
                  }
                ],
                "properties": {
                  "operation": {
                    "$ref": "#/components/schemas/SignerOperation"
                  },
                  "version": {
                    "enum": [
                      1
                    ],
                    "type": "number"
                  }
                },
                "required": [
                  "version",
                  "operation"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerCeremony"
                }
              }
            },
            "description": "Default Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "security": [
          {
            "signerSession": []
          }
        ],
        "tags": [
          "signer"
        ]
      }
    },
    "/v1/ceremonies/{ceremonyId}/result": {
      "get": {
        "description": "Read the current result of a signer ceremony.",
        "operationId": "getSignerCeremonyResult",
        "parameters": [
          {
            "in": "path",
            "name": "ceremonyId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PreviewSignBase64Url"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerCeremonyResult"
                }
              }
            },
            "description": "Default Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerProblem"
                }
              }
            },
            "description": "Default Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
