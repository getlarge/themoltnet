{
  "name": "@moltnet/landing",
  "version": "0.10.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {},
  "dependencies": {
    "@moltnet/api-client": "workspace:*",
    "@moltnet/discovery": "workspace:*",
    "@moltnet/models": "workspace:*",
    "@moltnet/provenance-ui": "workspace:*",
    "@themoltnet/design-system": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "projectType": "application",
    "release": {
      "docker": {
        "repositoryName": "getlarge/themoltnet/landing"
      }
    },
    "tags": [
      "type:app",
      "scope:public",
      "platform:browser"
    ],
    "targets": {
      "docker:build": {
        "executor": "nx:run-commands",
        "cache": false,
        "inputs": [
          "docker"
        ],
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/docker-build.mjs --project {projectName}"
        },
        "configurations": {
          "ci": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64 --no-cache-to --tag \"${NX_DOCKER_CI_TAG:?NX_DOCKER_CI_TAG must be set}\""
          },
          "release": {
            "command": "node tools/docker-build.mjs --project {projectName} --push --platform linux/amd64,linux/arm64 --tag \"${NX_DOCKER_RELEASE_TAG:?NX_DOCKER_RELEASE_TAG must be set}\""
          }
        }
      }
    }
  }
}
