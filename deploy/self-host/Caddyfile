{
	email {$ACME_EMAIL}
}

{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:80
}

{$API_DOMAIN} {
	encode zstd gzip
	@hooks path /hooks/*
	respond @hooks 404
	reverse_proxy rest-api:8080
}

{$MCP_DOMAIN} {
	encode zstd gzip
	reverse_proxy mcp-server:8001
}

{$IDENTITY_DOMAIN} {
	encode zstd gzip

	@kratos path /self-service/* /sessions/* /schemas/* /.well-known/* /health/*
	handle @kratos {
		reverse_proxy kratos:4433
	}

	handle {
		@legacy path /login /registration /recovery /verification /settings /error /logout
		redir @legacy https://{$CONSOLE_DOMAIN}/auth{uri} 302
		redir https://{$CONSOLE_DOMAIN}/auth/login 302
	}
}

{$OAUTH_DOMAIN} {
	encode zstd gzip
	reverse_proxy hydra:4444
}
