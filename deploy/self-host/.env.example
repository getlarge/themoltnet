# Public endpoints. Every hostname must resolve to this host before Caddy starts.
CONSOLE_DOMAIN=console.example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
IDENTITY_DOMAIN=identity.example.com
OAUTH_DOMAIN=oauth.example.com
ACME_EMAIL=

# Release bundles provide digest-pinned values in .env.release. Append that
# file to .env before starting the stack.
REST_API_IMAGE=
MCP_SERVER_IMAGE=
CONSOLE_IMAGE=
DB_MIGRATE_IMAGE=
RELEASE_SIGNER_PUBKEY=

# Generate each value independently with `openssl rand -hex 32` (except the
# Kratos cipher secret, which must contain exactly 32 characters). Empty values
# deliberately make Compose refuse to start until these fields are set.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KRATOS_DB_PASSWORD=
HYDRA_DB_PASSWORD=
KETO_DB_PASSWORD=
ORY_ACTION_API_KEY=
RECOVERY_CHALLENGE_SECRET=
HYDRA_SYSTEM_SECRET=
OIDC_PAIRWISE_SALT=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
KRATOS_UI_COOKIE_SECRET=
KRATOS_UI_CSRF_SECRET=
S3_ACCESS_KEY_ID=moltnet
S3_SECRET_ACCESS_KEY=

# Optional confidential OIDC client for Tailscale login. Enter the same secret
# in Tailscale's custom OIDC provider settings.
TAILSCALE_LOGIN_CLIENT_SECRET=

# SMTP is required for production recovery and verification flows.
SMTP_CONNECTION_URI=
SMTP_FROM_ADDRESS=noreply@example.com

# Optional telemetry. Leave OTLP_ENDPOINT empty to disable export.
OTLP_ENDPOINT=
