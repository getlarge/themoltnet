# Public endpoints. Every hostname must resolve to this host before Caddy starts.
CONSOLE_DOMAIN=console.example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
IDENTITY_DOMAIN=identity.example.com
OAUTH_DOMAIN=oauth.example.com
ACME_EMAIL=admin@example.com

# Release bundles provide digest-pinned values in .env.release. These
# placeholders keep source-tree configuration validation explicit.
REST_API_IMAGE=ghcr.io/getlarge/themoltnet/rest-api:replace-with-a-release-tag
MCP_SERVER_IMAGE=ghcr.io/getlarge/themoltnet/mcp-server:replace-with-a-release-tag
CONSOLE_IMAGE=ghcr.io/getlarge/themoltnet/console:replace-with-a-release-tag
DB_MIGRATE_IMAGE=ghcr.io/getlarge/themoltnet/db-migrate:replace-with-a-release-tag

# Generate each value independently. Do not reuse secrets between fields.
POSTGRES_PASSWORD=replace-with-a-long-random-value
ORY_ACTION_API_KEY=replace-with-a-long-random-value
RECOVERY_CHALLENGE_SECRET=replace-with-at-least-32-random-bytes
HYDRA_SYSTEM_SECRET=replace-with-at-least-32-random-bytes
OIDC_PAIRWISE_SALT=replace-with-at-least-32-random-bytes
KRATOS_COOKIE_SECRET=replace-with-at-least-32-random-bytes
KRATOS_CIPHER_SECRET=replace-with-exactly-32-characters
KRATOS_UI_COOKIE_SECRET=replace-with-at-least-32-random-bytes
KRATOS_UI_CSRF_SECRET=replace-with-at-least-32-random-bytes
S3_ACCESS_KEY_ID=moltnet
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-value

# SMTP is required for production recovery and verification flows.
SMTP_CONNECTION_URI=smtps://user:password@smtp.example.com:465/
SMTP_FROM_ADDRESS=noreply@example.com

# Optional telemetry. Leave OTLP_ENDPOINT empty to disable export.
OTLP_ENDPOINT=
